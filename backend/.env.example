# Django Settings
# SECURITY: Generate a new SECRET_KEY for production
# Run: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode - NEVER set to True in production
DEBUG=False

# Allowed hosts - comma-separated list (no spaces)
# Development: localhost,127.0.0.1
# Production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=book-club.jkproduction.pro,localhost,127.0.0.1

# Database Configuration
DB_NAME=bookclub_db
DB_USER=bookclub
DB_PASSWORD=your_database_password
DB_HOST=109.173.104.21
DB_PORT=56424

# MinIO/S3 Storage Configuration
AWS_S3_ENDPOINT_URL=https://s3-ef-minio.jkproduction.pro
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=book-club
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_USE_SSL=True
AWS_S3_VERIFY=True
AWS_QUERYSTRING_AUTH=False
AWS_QUERYSTRING_EXPIRE=3600
AWS_S3_FILE_OVERWRITE=False

# Logging Configuration
LOG_FILE_PATH=bookapp/app.log
LOG_LEVEL=INFO

# CORS Settings (for production)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://book-club.jkproduction.pro,https://book-club.jkproduction.pro:443
CSRF_TRUSTED_ORIGINS=https://book-club.jkproduction.pro,https://book-club.jkproduction.pro:443

# HTTPS/SSL Settings (for production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
