# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=book-club.jkproduction.pro,localhost,127.0.0.1

# Database
DB_NAME=bookclub_db
DB_USER=bookclub
DB_PASSWORD=your_database_password
DB_HOST=109.173.104.21
DB_PORT=56424

# Logging
LOG_FILE_PATH=bookapp/app.log
LOG_LEVEL=INFO

# MinIO / S3
AWS_S3_ENDPOINT_URL=https://s3-ef-minio.jkproduction.pro
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=your_minio_secret_key
AWS_STORAGE_BUCKET_NAME=book-club
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_USE_SSL=true
AWS_S3_VERIFY=true
# If the bucket is private (MinIO default), keep this enabled so the backend returns presigned URLs.
# If you made the bucket public-read, you can set it to false for stable, unsigned URLs.
AWS_QUERYSTRING_AUTH=true
AWS_QUERYSTRING_EXPIRE=86400
AWS_S3_FILE_OVERWRITE=false

# CORS/CSRF
CORS_ALLOWED_ORIGINS=https://book-club.jkproduction.pro,https://book-club.jkproduction.pro:443
CSRF_TRUSTED_ORIGINS=https://book-club.jkproduction.pro,https://book-club.jkproduction.pro:443

# HTTPS/SSL
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Frontend build
VITE_BASE_URL=https://book-club.jkproduction.pro:8000
VITE_API_BASE_URL=https://book-club.jkproduction.pro:8000
